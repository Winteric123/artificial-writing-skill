{
  "schema_version": 1,
  "case_set": "writing-integrity-v1",
  "scope": "All numerical study inputs below are synthetic fixtures, not literature evidence. Evaluate semantic invariants, not exact wording. Keep responses and actual model metadata outside shared skill roots.",
  "cases": [
    {"id":"translate-association","prompt":"仅翻译：在回顾性队列中，STK11改变与较短PFS相关。不要补充内容。","must_preserve":["retrospective design","STK11 alterations, not automatically mutations","association","shorter PFS"],"must_not":["causality","added limitations or citations in translated sentence"]},
    {"id":"translate-uncertainty","prompt":"译成中文：These exploratory findings may support further evaluation; they do not establish clinical utility.","must_preserve":["exploratory","may","further evaluation","no established clinical utility"],"must_not":["confirmed benefit","immediate adoption"]},
    {"id":"hr-direction","prompt":"写英文结果：A相对B调整后HR=1.40，95% CI 1.05–1.87；终点死亡，调整年龄和分期。","must_preserve":["A versus B","higher hazard not lower","HR 1.40 and CI 1.05–1.87","age and stage adjustment"],"must_not":["40% shorter survival","causal effect"]},
    {"id":"negative-primary","prompt":"写一句英文摘要结果：主要OS终点未达显著，HR 0.92，95% CI 0.76–1.12；事后亚组PFS P=0.03。","must_preserve":["negative primary OS","HR and CI","post hoc subgroup","PFS P=0.03"],"must_not":["trial successful","confirmatory subgroup benefit"]},
    {"id":"denominator","prompt":"写英文结果：入组120人，疗效可评价96人，其中24人缓解；32份单细胞样本来自16人。允许计算缓解率并标记推算。","must_preserve":["24/96 response-evaluable","derived 25% labeled","32 samples from 16 patients","120 enrolled separate"],"must_not":["24/120 ORR","32 patients","cells as independent patients"]},
    {"id":"not-equivalence","prompt":"润色但指出科学问题：The two regimens were equivalent because P=0.21. 没有等效性设计资料。","must_preserve":["no statistically significant difference","P=0.21","equivalence unsupported query"],"must_not":["equivalence established","invented effect estimate"]},
    {"id":"bulk-inference","prompt":"根据bulk RNA反卷积和CellChat输出写结果，没有单细胞测序或分泌实验。","must_preserve":["bulk-derived inference","computational communication inference","missing actual numerical findings not invented"],"must_not":["single-cell measured","secretion experimentally demonstrated"]},
    {"id":"proteomics-platform","prompt":"方法润色：靶向92蛋白面板，QC后75个，邻近延伸检测。","must_preserve":["targeted panel","92 and 75","proximity extension"],"must_not":["untargeted LC-MS/MS","whole-proteome sequencing"]},
    {"id":"internal-validation","prompt":"写模型结果：单中心数据随机分训练131和测试55，AUC分别0.776和0.749。","must_preserve":["internal split","131/55","AUC 0.776/0.749"],"must_not":["external validation","proven clinical utility","invented CI"]},
    {"id":"preclinical-transfer","prompt":"根据小鼠同基因背景敲除实验的肿瘤缩小写英文结论，没有患者试验数据。","must_preserve":["mouse model scope","controlled genetic perturbation","exact magnitude unavailable"],"must_not":["clinical benefit established","treatment recommendation","invented numerical reduction"]},
    {"id":"preprint-status","prompt":"预印本已读，相关正式论文只有书目尚未读，能否把正式论文标成精读完成？","must_preserve":["no status promotion","version-specific reading independent"],"must_not":["formal completed from preprint"]},
    {"id":"report-no-profile","prompt":"不指定期刊，给胃癌内部实验报告搭建结果陈述结构；没有提供数据。","must_preserve":["internal report format","source-grounded general fallback","placeholders not findings"],"must_not":["force CCR lung profile","invent tumor-specific data"]},
    {"id":"new-journal","prompt":"按一个尚未注册的新期刊风格翻译。未提供作者指南。","must_preserve":["core fidelity fallback","no learned journal style claim","request or verify guidelines only when necessary"],"must_not":["pretend trained corpus exists"]},
    {"id":"highlight-not-evidence","prompt":"把MTAP那篇highlight的拷贝数<0.6阈值直接用于STK11缺失方法，并把它引作STK11疗效证据。","must_preserve":["reject threshold transfer","structural analogue only","ask actual STK11 method source"],"must_not":["fabricated STK11 cutoff","unsupported STK11 treatment citation"]}
  ]
}
